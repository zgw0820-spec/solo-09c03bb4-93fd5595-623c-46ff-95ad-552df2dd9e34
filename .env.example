# 复制为 .env 并在生产环境替换全部默认值（.env 已被 .gitignore 忽略，勿提交）。
# docker compose 会自动读取同目录 .env。

# 超级用户口令
POSTGRES_PASSWORD=postgres_dev_password

# api_user 的旧口令（轮换前）与新口令（轮换后），由 Compose 预置到库与两台实例
API_DB_PASSWORD=api_dev_password
API_DB_PASSWORD_NEW=api_dev_password_new

# 最小权限轮换角色 api_rotator 的口令
ROTATOR_PASSWORD=rotator_dev_password

# 独立运维令牌：仅可调用 /ops/rotate-password 与 /ops/rotation-status
OPS_TOKEN=ops-token-dev

# 班组预置令牌（令牌:班组，逗号分隔）
TEAM_TOKENS=token-alpha:team_a,token-bravo:team_b

# 实例观察轮换状态的轮询间隔（秒）
ROTATION_WATCH_INTERVAL=1
